<resources>
    <string name="app_name">open-easy-web</string>
    <string name="app_name_powersave">open-easy-web (省電力)</string>
    <string name="app_name_normal">open-easy-web (通常)</string>
    <string name="app_name_alwayson">open-easy-web (常時電源)</string>

    <string name="profile_select_title">電源プロファイルを選択</string>
    <string name="profile_select_subtitle">端末の使い方に合わせて選んでください。あとで「プロファイル変更」からいつでも選び直せます。</string>

    <string name="profile_power_save_button">🔋 省電力 モード</string>
    <string name="profile_power_save_desc">スマホとして普段使いする端末向け。バックグラウンドでの常時稼働を避け、Android標準の省電力(Doze)機能に逆らいません。</string>

    <string name="profile_normal_button">⚖️ 通常 モード</string>
    <string name="profile_normal_desc">通常のスマホ利用とサーバー稼働を両立するバランス型(既定)。</string>

    <string name="profile_always_on_button">🔌 常時電源接続 モード</string>
    <string name="profile_always_on_desc">充電しっぱなしのサーバー専用端末向け。WakeLockでスリープを防ぎ、常時稼働を優先します。</string>

    <string name="open_browser_button">🌐 ブラウザで開く</string>
    <string name="shutdown_button">⏻ シャットダウン</string>
    <string name="restart_button">🔁 再起動</string>
    <string name="change_profile_button">電源プロファイルを変更</string>
    <string name="memory_info_button">📊 Memory info (メモリ情報)</string>
    <string name="uninstall_button">🗑️ Uninstall (アンインストール)</string>
    <string name="disk_info_button">💾 Disk info (ディスク情報)</string>
    <string name="pie_chart_label_real_memory">Physical memory (実メモリ)</string>
    <string name="pie_chart_label_virtual_memory">Virtual memory / swap (仮想メモリ)</string>
    <string name="pie_chart_label_total_memory">Total (合計)</string>
    <string name="pie_chart_label_disk">Disk usage (ディスク使用状況)</string>

    <string name="external_storage_button">💽 外付けHDDをストレージに使う(root)</string>
    <string name="external_storage_dialog_title">外付けHDDを主ストレージに使う(root化端末専用)</string>
    <string name="external_storage_dialog_message">root化していない端末では、ネイティブサーバーが外部USBストレージへ直接読み書きできません(Android Scoped Storageの制限)。root化済みの端末で、マウント済みのパス(例: /mnt/media_rw/XXXX-XXXX)を入力してください。次回のサーバー起動から有効になります。</string>
    <string name="external_storage_path_hint">マウントパス(例: /mnt/media_rw/XXXX-XXXX)</string>
    <string name="external_storage_enable_checkbox">有効化する</string>
    <string name="external_storage_save_button">保存</string>

    <string name="fixed_account_button">👤 固定アカウント設定(必須)</string>
    <string name="fixed_account_dialog_title">固定アカウントのメールアドレス</string>
    <string name="fixed_account_dialog_message">open-easy-web-serverは、このメールアドレスを固定アカウントとして起動時に登録します(OPEN_EASYWEB_FIXED_ACCOUNT_EMAIL、未設定だと起動できません)。ログイン用のワンタイムパスワードがこのアドレス宛に届きます。</string>
    <string name="fixed_account_email_hint">メールアドレス</string>
</resources>
