<?xml version="1.0" encoding="utf-8"?>
<!--
  MemoryInfoButtonのダイアログレイアウト(2026-08-06新規、円グラフ表示追加)。
  既存のテキスト表示(実メモリ・仮想メモリ)は残し、実メモリ用・仮想メモリ用・
  合計(実メモリ+仮想メモリの単純加算)用のPieChartView(汎用円グラフ
  カスタムView)を3つ並べて追加する。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/memoryInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <tokyo.runo.openeasyweb.PieChartView
                android:id="@+id/memoryRealPieChart"
                android:layout_width="80dp"
                android:layout_height="80dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pie_chart_label_real_memory"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <tokyo.runo.openeasyweb.PieChartView
                android:id="@+id/memoryVirtualPieChart"
                android:layout_width="80dp"
                android:layout_height="80dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pie_chart_label_virtual_memory"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <tokyo.runo.openeasyweb.PieChartView
                android:id="@+id/memoryTotalPieChart"
                android:layout_width="80dp"
                android:layout_height="80dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pie_chart_label_total_memory"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
